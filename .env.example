# SupportDesk AI Configuration
PROJECT_NAME="SupportDesk AI"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default local SQLite file:
DATABASE_URL="sqlite:///./supportdesk.db"
# Or PostgreSQL for production / Docker:
# DATABASE_URL="postgresql+psycopg2://supportdesk_user:supportdesk_pass@localhost:5432/supportdesk_db"

# AI Provider Configuration
# Choose: demo | gemini | openai
AI_PROVIDER="demo"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
